DISCORD_TOKEN=replace_with_your_bot_token
CONFIG_PATH=config.toml
# Commands sync instantly to this server. Remove for global sync.
DISCORD_GUILD_ID=1558235113295315004
DATABASE_PATH=department_manager.db
# Comma-separated Discord user IDs who always have bot-admin access.
BOT_OWNER_IDS=1090083387638812755,1099651002208104488

# Shared organization duty-hours API (same token as the Gang Manager).
FBRP_API_URL=http://127.0.0.1:8080
FBRP_API_TOKEN=replace_with_shared_service_token

# Department Coordination roster and Department Email Database (spreadsheet IDs in config.toml).
# Path to a Google service account key file that has Editor access to both sheets. Keep it outside the repository.
GOOGLE_SERVICE_ACCOUNT_FILE=
# Where /badge links to the orgs website (default https://floridabay.net/orgs).
FBRP_ORGS_URL=
