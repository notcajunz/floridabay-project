DISCORD_BOT_TOKEN=
ROLE_MANAGER_BOT_TOKEN=
ROLE_MANAGER_SUPERUSER_IDS=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_IDS=
IAA_MAIN_GUILD_ID=1557594282976747550
IAA_MAIN_LEAVE_LOG_CHANNEL_ID=1570228249165037579
FBRP_SUPERUSER_IDS=

MARIADB_HOST=127.0.0.1
MARIADB_PORT=3307
MARIADB_DATABASE=fbrp
MARIADB_USER=fbrp
MARIADB_PASSWORD=replace-with-a-long-random-password

FBRP_SERVICE_TOKEN=replace-with-another-long-random-secret
# Must match FBRP_API_TOKEN in both manager bots.
GANGS_API_TOKEN=replace-with-a-shared-manager-api-secret
FBRP_FIVEM_ORIGIN=http://127.0.0.1:30120/fbrp_core
FBRP_DEV_FIVEM_ORIGIN=
FBRP_DEV_SERVICE_TOKEN=
FBRP_DEV_SFTP_HOST=
FBRP_DEV_SFTP_PORT=22
FBRP_DEV_SFTP_USER=
FBRP_DEV_SFTP_PASSWORD=
FBRP_DEV_SFTP_ROOT=/
FBRP_DEV_SFTP_HOST_FINGERPRINT=
# Staff permissions Google Sheet (src/staff-permissions-sheet.js). A service account used only for that sheet; its key file stays outside the repository.
FBRP_STAFF_PERMS_SERVICE_ACCOUNT_FILE=
FBRP_STAFF_PERMS_SHEET_ID=
FBRP_TICKET_PANEL_CHANNEL_ID=
FBRP_VERIFIED_ROLE_ID=1570228067501211648
FBRP_VERIFICATION_CHANNEL_ID=1570228122874286130
FBRP_UNVERIFIED_ROLE_NAME="FBRP | Unverified"

# Public website, Discord-authenticated member portal, and owner-only live
# configuration. Keep the listener private and expose it through HTTPS.
FBRP_PANEL_HOST=127.0.0.1
FBRP_PANEL_PORT=8080
FBRP_PUBLIC_URL=https://example.com/fbrp
FBRP_CONNECT_URL=fivem://connect/your-server.example:30120

# Tebex Headless API. Copy the public token from Tebex Creator Panel > Developers > API Keys.
# Package definitions, prices, tax, coupons and payment stay managed entirely in Tebex.
TEBEX_PUBLIC_TOKEN=
# Developers > Webhooks > Endpoints secret. Never expose this to the browser.
TEBEX_WEBHOOK_SECRET=
FBRP_STORE_HOST=store.floridabay.net

# One live message is maintained in this channel and refreshed every minute.
# Restart times use the named timezone, including daylight-saving changes.
FBRP_STATUS_CHANNEL_ID=1570228138347077795
FBRP_STATUS_REFRESH_MS=60000
FBRP_MAX_PLAYERS=48
FBRP_RESTART_TIMES=00:00,06:00,12:00,18:00
FBRP_RESTART_TIMEZONE=UTC

# Personal vehicle importer (portal: Add personal vehicle > Import from the VPS with AI)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Department badge reading (the lightest vision model is plenty): where name, rank and callsign go.
BADGE_AI_MODEL=gpt-5.4-nano

# FBRP Personals Discord bot (/personal), runs as personals-bot.service
PERSONALS_BOT_TOKEN=

# FBRP DevOps bot (src/devops), runs as devops-bot.service
DEVOPS_BOT_TOKEN=
DEVOPS_BOT_ID=
DEVOPS_GUILD_ID=


# IAA roster / SOP / locked alt database (see docs/IAA_DOCUMENTS.md). Path to a Google service account key kept outside the repository.
IAA_GOOGLE_SERVICE_ACCOUNT_FILE=
