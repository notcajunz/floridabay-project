+        /// <summary>
+        /// Florida Bay RP: saves a character received through a share code as a new, uncategorized copy.
+        /// </summary>
+        internal void ImportSharedCharacter(string suggestedName, string json)
+        {
+            if (!vMenuShared.PermissionsManager.IsAllowed(vMenuShared.PermissionsManager.Permission.PAMenu))
+            {
+                Notify.Error(CommonErrors.NotAllowed, placeholderValue: "import characters");
+                return;
+            }
+
+            MultiplayerPedData imported;
+            try
+            {
+                imported = JsonConvert.DeserializeObject<MultiplayerPedData>(json);
+            }
+            catch
+            {
+                Notify.Error("That share code did not contain a readable character.");
+                return;
+            }
+
+            var maleModel = (uint)GetHashKey("mp_m_freemode_01");
+            var femaleModel = (uint)GetHashKey("mp_f_freemode_01");
+            if (imported.Version < 1 || (imported.ModelHash != maleModel && imported.ModelHash != femaleModel) || imported.IsMale != (imported.ModelHash == maleModel))
+            {
+                Notify.Error("That share code did not contain a valid multiplayer character.");
+                return;
+            }
+
+            var baseName = new string((suggestedName ?? "").Where(c => !char.IsControl(c)).ToArray()).Trim();
+            if (baseName.StartsWith("mp_ped_"))
+            {
+                baseName = baseName.Substring(7);
+            }
+            if (baseName.Length == 0)
+            {
+                baseName = "Shared Character";
+            }
+            if (baseName.Length > 24)
+            {
+                baseName = baseName.Substring(0, 24).Trim();
+            }
+
+            var name = baseName;
+            for (var copy = 2; !string.IsNullOrEmpty(GetResourceKvpString("mp_ped_" + name)) && copy < 100; copy++)
+            {
+                name = $"{baseName} ({copy})";
+            }
+
+            imported.SaveName = "mp_ped_" + name;
+            imported.Category = null;
+
+            if (StorageManager.SaveJsonData("mp_ped_" + name, JsonConvert.SerializeObject(imported), false))
+            {
+                Notify.Success($"Imported the shared character as ~g~<C>{name}</C>~s~. Find it under Saved Characters > Uncategorized.");
+                UpdateSavedPedsMenu();
+            }
+            else
+            {
+                Notify.Error("The shared character could not be saved.");
+            }
+        }
