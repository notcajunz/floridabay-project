+    #region ox_lib bridge
+    /// <summary>
+    /// Florida Bay RP: every vMenu notification and subtitle is shown with ox_lib's notification system
+    /// (the ox_lib:notify event) instead of the game's notification feed.
+    /// </summary>
+    internal static class OxLibNotify
+    {
+        // System.Text.RegularExpressions fails verification inside the CitizenFX Mono sandbox
+        // (MethodAccessException), so the markup is stripped with plain string scanning instead.
+        internal static string Clean(string message)
+        {
+            if (string.IsNullOrEmpty(message))
+            {
+                return "";
+            }
+
+            var text = message.Replace("~n~", "\n")
+                .Replace("<C>", "").Replace("</C>", "").Replace("<c>", "").Replace("</c>", "");
+            var result = new System.Text.StringBuilder(text.Length);
+            for (var i = 0; i < text.Length; i++)
+            {
+                if (text[i] == '~')
+                {
+                    var end = i + 1;
+                    while (end < text.Length && (char.IsLetterOrDigit(text[end]) || text[end] == '_'))
+                    {
+                        end++;
+                    }
+
+                    if (end < text.Length && text[end] == '~')
+                    {
+                        i = end;
+                        continue;
+                    }
+                }
+
+                result.Append(text[i]);
+            }
+
+            return result.ToString().Trim();
+        }
+
+        private static readonly HashSet<MenuAPI.Menu> attachedMenus = new HashSet<MenuAPI.Menu>();
+        private static int lastShown = -1;
+        private static int lastInput = -1;
+
+        /// <summary>Called when a text prompt opens, so the action behind it is not announced a second time.</summary>
+        internal static void MarkInput() => lastInput = GetGameTimer();
+
+        /// <summary>
+        /// Announces a menu action unless the action showed a notification of its own (or asked for text input)
+        /// within a short window, so toggles and plain buttons that stay silent in vanilla vMenu are covered
+        /// without doubling the ones that already report their result.
+        /// </summary>
+        private static async void Announce(string type, string text, int window, bool onlyInSameMenu = false)
+        {
+            var started = GetGameTimer();
+            var openMenu = MenuAPI.MenuController.GetCurrentMenu();
+            await BaseScript.Delay(window);
+            if (lastShown >= started || lastInput >= started - 50)
+            {
+                return;
+            }
+
+            // A button that opened or closed a menu was navigation, not an action.
+            if (onlyInSameMenu && MenuAPI.MenuController.GetCurrentMenu() != openMenu)
+            {
+                return;
+            }
+
+            Show(type, text, 3000);
+        }
+
+        internal static void AttachMenuActions()
+        {
+            foreach (var menu in MenuAPI.MenuController.Menus)
+            {
+                if (!attachedMenus.Add(menu))
+                {
+                    continue;
+                }
+
+                menu.OnCheckboxChange += (_, item, _, state) => Announce(state ? "success" : "info", $"{Clean(item.Text)}: {(state ? "enabled" : "disabled")}", 250);
+                menu.OnListItemSelect += (_, item, selectedIndex, _) => Announce("info", $"{Clean(item.Text)}: {Clean(item.ListItems[selectedIndex])}", 450);
+                menu.OnItemSelect += (_, item, _) =>
+                {
+                    if (!item.Enabled || item is MenuAPI.MenuListItem || item is MenuAPI.MenuCheckboxItem || item is MenuAPI.MenuDynamicListItem)
+                    {
+                        return;
+                    }
+
+                    var text = Clean(item.Text);
+                    if (text.Length > 0)
+                    {
+                        Announce("info", text, 700, true);
+                    }
+                };
+            }
+        }
+
+        internal static void Show(string type, string message, int duration = 5000, string title = "vMenu")
+        {
+            var description = Clean(message);
+            if (description.Length == 0)
+            {
+                return;
+            }
+
+            lastShown = GetGameTimer();
+
+            BaseScript.TriggerEvent("ox_lib:notify", new Dictionary<string, object>
+            {
+                ["title"] = title,
+                ["description"] = description,
+                ["type"] = type,
+                ["duration"] = duration,
+            });
+        }
+    }
+    #endregion
+
