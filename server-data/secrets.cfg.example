# Copy to secrets.cfg and keep the real file private.
# MariaDB URI format: mysql://USER:PASSWORD@HOST:PORT/DATABASE?charset=utf8mb4
set mysql_connection_string "mysql://fbrp:CHANGE_ME@127.0.0.1:3306/fbrp?charset=utf8mb4"

# Must exactly match FBRP_SERVICE_TOKEN in services/fbrp-bot/.env.
set fbrp_serviceToken "CHANGE_ME_TO_A_LONG_RANDOM_SECRET"

set fbrp_discordInvite "https://discord.gg/floridabay"
set fbrp_mainGuild "YOUR_MAIN_DISCORD_GUILD_ID"

# sky_phone password peppers (server-only; use set, never setr/sets). Generate each
# once with `openssl rand -hex 32` and never change them afterwards: a new value
# invalidates every phone passcode or app password hashed with the old one.
set sky_phone_passcode_pepper "CHANGE_ME_64_HEX"
set sky_phone_crewlink_pepper "CHANGE_ME_64_HEX"
set sky_phone_fliptok_pepper "CHANGE_ME_64_HEX"
set sky_phone_picstagram_pepper "CHANGE_ME_64_HEX"

# sky_phone FiveManage V3 token with Media access (server-only; use set, never setr/sets).
# Create it at https://fivemanage.com/ > Dashboard > Tokens. Without it camera photo and
# video uploads, voice memos, and Gallery imports are disabled.
set sky_phone_fivemanage_token ""

# Quantix-Queue Discord bot token (server-only; use set, never setr/sets).
set quantix_discord_token ""
