# Copy to secrets.cfg and keep the real file private.
# MariaDB URI format: mysql://USER:PASSWORD@HOST:PORT/DATABASE?charset=utf8mb4
set mysql_connection_string "mysql://fbrp:CHANGE_ME@127.0.0.1:3306/fbrp?charset=utf8mb4"

# Must exactly match FBRP_SERVICE_TOKEN in services/fbrp-bot/.env.
set fbrp_serviceToken "CHANGE_ME_TO_A_LONG_RANDOM_SECRET"

set fbrp_discordInvite "https://discord.gg/CHANGE_ME"
set fbrp_mainGuild "YOUR_MAIN_DISCORD_GUILD_ID"
