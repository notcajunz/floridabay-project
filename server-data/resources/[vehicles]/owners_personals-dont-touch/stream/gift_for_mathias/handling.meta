      <fCamberStiffnesss value="0.000000" />
      <fTractionBiasFront value="0.500000" />
      <fTractionLossMult value="0.450000" />

      <!-- STABLE SPORT SUSPENSION -->
      <fSuspensionForce value="3.200000" />
      <fSuspensionCompDamp value="2.200000" />
      <fSuspensionReboundDamp value="2.800000" />
      <fSuspensionUpperLimit value="0.080000" />
      <fSuspensionLowerLimit value="-0.100000" />
      <fSuspensionRaise value="-0.015000" />
      <fSuspensionBiasFront value="0.520000" />

      <!-- ANTI-ROLL STABILITY -->
      <fAntiRollBarForce value="1.600000" />
      <fAntiRollBarBiasFront value="0.550000" />
      <fRollCentreHeightFront value="0.180000" />
      <fRollCentreHeightRear value="0.180000" />

      <!-- DAMAGE -->
      <fCollisionDamageMult value="0.500000" />
      <fWeaponDamageMult value="1.000000" />
      <fDeformationDamageMult value="0.500000" />
      <fEngineDamageMult value="0.500000" />

      <!-- FUEL -->
      <fPetrolTankVolume value="73.000000" />
      <fOilVolume value="6.000000" />

      <!-- SEAT POSITION -->
      <fSeatOffsetDistX value="0.000000" />
      <fSeatOffsetDistY value="0.000000" />
      <fSeatOffsetDistZ value="0.000000" />

      <!-- VEHICLE VALUE AND FLAGS -->
      <nMonetaryValue value="120000" />
      <strModelFlags>440010</strModelFlags>
      <strHandlingFlags>0</strHandlingFlags>
      <strDamageFlags>0</strDamageFlags>
