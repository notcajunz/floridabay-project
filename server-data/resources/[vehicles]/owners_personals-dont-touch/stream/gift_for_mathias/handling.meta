      <fClutchChangeRateScaleUpShift value="8.000000" />
      <fClutchChangeRateScaleDownShift value="7.000000" />

      <!-- EXTREME TOP SPEED -->
      <fInitialDriveMaxFlatVel value="350.000000" />

