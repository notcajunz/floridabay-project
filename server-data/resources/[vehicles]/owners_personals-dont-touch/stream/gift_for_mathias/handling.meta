      <fBrakeForce value="3.000000" />
      <fBrakeBiasFront value="0.580000" />
      <fHandBrakeForce value="1.000000" />

      <!-- HIGH-SPEED STEERING -->
      <fSteeringLock value="34.000000" />

      <!-- INSANE TRACTION -->
      <fTractionCurveMax value="6.500000" />
      <fTractionCurveMin value="6.200000" />
