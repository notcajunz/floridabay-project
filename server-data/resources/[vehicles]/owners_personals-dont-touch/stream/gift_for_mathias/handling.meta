
<?xml version="1.0" encoding="UTF-8"?>

<CHandlingDataMgr>
  <HandlingData>
    <Item type="CHandlingData">

      <!-- AUDI RS6 AVANT - ULTIMATE PERFORMANCE V5 -->
      <!-- EXTREME SPEED, GRIP AND ANTI-ROLL STABILITY -->

      <handlingName>mathias_rs62</handlingName>

      <!-- MASS AND AERODYNAMICS -->
      <fMass value="3500.000000" />
      <fInitialDragCoeff value="1.000000" />
      <fDownforceModifier value="2.500000" />
      <fPercentSubmerged value="85.000000" />

      <!-- STABLE CENTER OF GRAVITY -->
      <vecCentreOfMassOffset
        x="0.000000"
        y="0.000000"
        z="-0.250000" />

      <!-- IMPROVED ROLL STABILITY -->
      <vecInertiaMultiplier
        x="1.800000"
        y="1.900000"
        z="2.000000" />

      <!-- QUATTRO AWD -->
      <fDriveBiasFront value="0.500000" />
