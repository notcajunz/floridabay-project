<?xml version = "1.0" encoding = "UTF-8"?>

<!-- FBRP: registers ONE track, the Roxwood shuttle, as runtime track 12 (the vanilla table ends at 11).
     It is the cut of the Roxwood package's trains14.dat that dps-trains' data/tracks-12.lua describes:
     Roxwood station to Roxwood Junction, 335 nodes, stops at nodes 1, 94 and 335. -->
<train_tracks version = "1">
	<train_track
		filename="resources:/dps-traintracks/trains12.dat"
		trainConfigName="passenger_group"
		isPingPongTrack="true"
		stopsAtStations="true"
		MPstopsAtStations="true"
		speed="20"
		brakingDist="10"/>
</train_tracks>
