#!/usr/sbin/nft -f
# FBRP DDoS shield. Its own table, so ufw, fail2ban and Docker rules are left alone.
# This table only ever DROPS: an accept here ends this table's chain, and ufw and Docker still filter afterwards.
# Reload safely with: nft -f /etc/fbrp/ddos-shield.nft (the first two lines make it idempotent).

table inet fbrp_shield
delete table inet fbrp_shield

table inet fbrp_shield {
	# Never rate-limited: loopback, Docker bridges, and the owner's home IP (same list as fail2ban ignoreip).
	set trusted4 {
		type ipv4_addr
		flags interval
		elements = { 127.0.0.0/8, 172.16.0.0/12, 73.173.242.232 }
	}

	# Sources that flooded FiveM UDP get dropped outright for a while (cheaper than metering every packet).
	set fivem_ban4 {
		type ipv4_addr
		size 131072
		flags dynamic, timeout
		timeout 5m
	}

	# Per-IP token buckets. Entries expire on their own once a source goes quiet.
	set fivem_udp4 {
		type ipv4_addr
		size 131072
		flags dynamic, timeout
		timeout 1m
	}
	set fivem_http4 {
		type ipv4_addr
		size 65536
		flags dynamic, timeout
		timeout 1m
	}
	set fivem_conns4 {
		type ipv4_addr
		size 65536
		flags dynamic
	}
	set syn4 {
		type ipv4_addr
		size 131072
		flags dynamic, timeout
		timeout 1m
	}
	set web_conns4 {
		type ipv4_addr
		size 65536
		flags dynamic
	}
	set quic4 {
		type ipv4_addr
		size 65536
		flags dynamic, timeout
		timeout 1m
	}
	set ssh4 {
		type ipv4_addr
		size 16384
		flags dynamic, timeout
		timeout 5m
	}

	# Stateless junk, before conntrack spends memory on it.
	chain pre_raw {
		type filter hook prerouting priority raw; policy accept;
		iifname != "ens3" accept
		ip saddr @trusted4 accept

		ip saddr @fivem_ban4 counter drop

		# Impossible source addresses.
		ip saddr { 0.0.0.0/8, 127.0.0.0/8, 224.0.0.0/3 } counter drop

		# Malformed TCP flag combinations (scans and junk floods).
		tcp flags & (fin|syn|rst|psh|ack|urg) == 0x0 counter drop
		tcp flags & (fin|syn) == (fin|syn) counter drop
		tcp flags & (syn|rst) == (syn|rst) counter drop
		tcp flags & (fin|rst) == (fin|rst) counter drop
		tcp flags & (fin|ack) == fin counter drop
		tcp flags & (fin|syn|rst|psh|ack|urg) == (fin|psh|urg) counter drop
		tcp flags & (fin|syn|rst|psh|ack|urg) == (fin|syn|rst|psh|ack|urg) counter drop

		# A SYN must not carry a tiny MSS (resource-exhaustion trick).
		tcp flags & (syn|ack) == syn tcp option maxseg size 1-535 counter drop
	}

	# After conntrack (priority -200) and before Docker's DNAT (-100), so it also covers Caddy on 80/443.
	chain pre_mangle {
		type filter hook prerouting priority mangle; policy accept;
		iifname != "ens3" accept
		ip saddr @trusted4 accept

		ct state invalid counter drop

		# Reflection/amplification: unsolicited UDP from well-known amplifier ports.
		# Real replies to this server's own DNS/NTP lookups are "established" and pass.
		udp sport { 17, 19, 53, 69, 111, 123, 137, 161, 389, 520, 1900, 3283, 3702, 5353, 5683, 10001, 11211, 27015, 32414, 37810 } ct state new counter drop

		# Ping floods (other ICMP such as "fragmentation needed" is untouched).
		icmp type echo-request limit rate over 10/second burst 20 packets counter drop

		# SYN floods from one source, any TCP port. Syncookies cover spread-out ones.
		tcp flags & (syn|ack) == syn update @syn4 { ip saddr limit rate over 40/second burst 80 packets } counter drop

		# FiveM game traffic. A player sends well under 300 packets/s; 1500/s per IP leaves room for a few
		# players behind one home router. Going over bans the IP for 5 minutes.
		udp dport 30120 update @fivem_udp4 { ip saddr limit rate over 1500/second burst 3000 packets } add @fivem_ban4 { ip saddr } counter drop

		# FiveM HTTP (join handshake, info.json/players.json, resource downloads).
		tcp dport 30120 ct state new update @fivem_http4 { ip saddr limit rate over 30/second burst 120 packets } counter drop
		tcp dport 30120 ct state new add @fivem_conns4 { ip saddr ct count over 64 } counter drop

		# Website and portal via Caddy.
		tcp dport { 80, 443 } ct state new add @web_conns4 { ip saddr ct count over 128 } counter drop
		udp dport 443 update @quic4 { ip saddr limit rate over 2000/second burst 4000 packets } counter drop

		# txAdmin is reached through Caddy (tx.floridabay.net) only, never directly from the internet.
		tcp dport 40120 counter drop

		# SSH: fail2ban handles bad logins, this stops connection floods.
		tcp dport 22 ct state new update @ssh4 { ip saddr limit rate over 10/minute burst 20 packets } counter drop
	}
}
