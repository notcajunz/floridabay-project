# Secrets and personal data are saved only as encrypted bundles in snapshots/ (see scripts/github-sync.sh)
.env
**/.env
.sync/
# Live configs and any backup copies of them (server.cfg.bkp, server.cfg.bak-*, ...)
server-data/secrets.cfg*
!server-data/secrets.cfg.example
server-data/server.cfg*
txData/
server-data/db/
backups/

# Re-downloadable or regenerated at runtime
node_modules/
artifacts/
server-data/cache/
*.log
*.pid
.replxx_history
**/.replxx_history
.console-history

# vMenu Enhanced rewrites these on every start; fbrp_core generates vehicle-categories.json.
server-data/resources/[[]standalone]/vMenu.Enhanced/config/*.example
server-data/resources/[[]standalone]/vMenu.Enhanced/config/plugins/*
!server-data/resources/[[]standalone]/vMenu.Enhanced/config/plugins/README.md
server-data/resources/[[]standalone]/vMenu.Enhanced/config/vehicle-categories.json
